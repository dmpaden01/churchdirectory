# Docker Compose configuration for the production deployment (docker-compose.yml).
# Copy this file to `.env` in this same directory (next to docker-compose.yml)
# and fill in real values. `.env` is gitignored and must never be committed.
#
# This is separate from backend/.env, which is only used for local
# (non-Docker) development.

# --- MongoDB (churchdirectory-db container) ---
# Raw credentials used to bootstrap the mongo container's root user.
# Avoid characters that need URL-encoding in a connection string (@ : / ? # &)
# unless you percent-encode them in MONGO_URI below to match.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=<choose a strong password>

# Full connection string the backend uses - must reference the same
# credentials as above. Host is the internal Compose service name; only
# change it if you rename the churchdirectory-db service below.
MONGO_URI=mongodb://root:<same-password-as-above>@churchdirectory-db:27017/churchdirectory?authSource=admin

# --- Backend ---
JWT_SECRET=<a long random string>

# Cookies default to Secure (HTTPS-only) in production. Leave this at `true`
# if a reverse proxy (e.g. Nginx Proxy Manager) is terminating real HTTPS for
# visitors, even though the proxy talks to this app over plain HTTP
# internally - the browser's connection is what matters. Only set to `false`
# if visitors are hitting this app directly with no TLS anywhere in front.
COOKIE_SECURE=true

# --- Email (Google Workspace SMTP relay, SMTP AUTH + TLS) ---
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-relay-username>
SMTP_PASS=<smtp-relay-password>
SMTP_CLIENT_NAME=<your sending domain>
EMAIL_FROM="Church Directory <noreply@example.com>"

# --- Public URLs ---
# In this setup there is only ONE public entry point - the frontend/nginx
# container, which proxies /api internally to the backend. Both of these
# should normally be the SAME external URL (the domain users actually visit,
# e.g. the domain configured in your reverse proxy).
BACKEND_PUBLIC_URL=https://directory.example.com
FRONTEND_PUBLIC_URL=https://directory.example.com

# --- Networking ---
# Host port the frontend container's nginx is published on. Only relevant for
# direct/local access - not used if a reverse proxy reaches the container via
# npm-network below instead.
HTTP_PORT=80

# If routing through a reverse proxy (e.g. Nginx Proxy Manager) on the same
# Docker host: the name of its Docker network, so this app's frontend
# container can join it and be reached by container name. Find it with
# `docker network ls`, or check the network name in the proxy's own compose
# file. Must already exist before running `docker compose up`.
NPM_NETWORK_NAME=npm-network
