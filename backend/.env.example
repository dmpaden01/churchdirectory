# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored and must never be committed.

PORT=5000
MONGO_URI=mongodb://<user>:<password>@<host>:27017?retryWrites=true&w=majority
JWT_SECRET=<a long random string>

# --- Email (Google Workspace SMTP relay) ---
# Used for registration verification, admin approval/denial, and "set password" emails.
# Google Workspace SMTP relay host/port for SMTP AUTH + TLS (STARTTLS on 587).
# See: https://support.google.com/a/answer/2956491
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-relay-username>
SMTP_PASS=<smtp-relay-password>
# Hostname sent in the SMTP EHLO/HELO greeting. Defaults to this machine's OS
# hostname if left unset, which some mail servers penalize since it's not a
# real domain. Set it to your sending domain.
SMTP_CLIENT_NAME=example.com
EMAIL_FROM="Church Directory <noreply@example.com>"

# Alternative: if the relay is instead configured for IP-allowlisting rather
# than SMTP AUTH (Google Workspace Admin: Apps > Google Workspace > Gmail >
# Routing > SMTP relay service > "Only accept mail from the specified IP
# addresses"), omit SMTP_USER/SMTP_PASS entirely and typically use port 25:
# SMTP_PORT=25
# SMTP_IGNORE_TLS=true

# --- Public URLs ---
# Used to build absolute links in emails (must be reachable from wherever the
# recipient opens their email, not just from this machine).
# BACKEND_PUBLIC_URL: hits the API directly (e.g. the email-verification link).
# FRONTEND_PUBLIC_URL: hits the web app (e.g. the "set password" link).
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5173
